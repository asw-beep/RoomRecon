@@ -363,7 +363,19 @@ class Dataset:
         self.patch_size = patch_size
         self.load_depths = load_depths
         indices = np.arange(len(self.parser.image_names))
-        if split == "train":
+        # [roomrecon] An explicit split file (JSON: split name -> image names) replaces
+        # the every-Nth-image rule, so a dataset's own test frames can be used. A listed
+        # name that is not in the model is an error, never silently dropped.
+        split_file = os.environ.get("ROOMRECON_SPLIT")
+        if split_file:
+            with open(split_file) as f:
+                names = json.load(f).get(split, [])
+            lookup = {n: i for i, n in enumerate(self.parser.image_names)}
+            missing = [n for n in names if n not in lookup]
+            if missing:
+                raise ValueError(f"{split_file}: {len(missing)} '{split}' image(s) not in the model, e.g. {missing[:3]}")
+            self.indices = np.array(sorted(lookup[n] for n in names), dtype=np.int64)
+        elif split == "train":
             self.indices = indices[indices % self.parser.test_every != 0]
         else:
             self.indices = indices[indices % self.parser.test_every == 0]
